# Copy to .env and fill in. Never commit the real .env.
OPENROUTER_API_KEY=sk-or-v1-...

OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_VISION_MODEL=openai/gpt-5.4-mini
OPENROUTER_SEARCH_MODEL=openai/gpt-5.4-nano

OPENROUTER_APP_URL=https://prakashwatch.co
OPENROUTER_APP_TITLE=Prakash Watch Co. Catalog Agent

AGENT_CONCURRENCY=3
AGENT_MAX_SOURCES=4
AGENT_MAX_IMAGES=5
AGENT_MIN_IMAGE_WIDTH=600
AGENT_IMAGE_MODE=download
AGENT_CACHE=1
AGENT_RESPECT_ROBOTS=1
AGENT_BUDGET_USD=0

ADMIN_PASSWORD=choose-a-password
ADMIN_SECRET=random-32-byte-hex

AGENT_SERVICE_URL=http://127.0.0.1:8077
# AGENT_SERVICE_TOKEN=shared-secret-if-the-agent-is-not-on-localhost

# Delhivery B2C API token, and the pickup location name exactly as it is
# registered in Delhivery One. Both come from the courier, not from us.
DELHIVERY_TOKEN=
DELHIVERY_PICKUP_NAME=

# Razorpay live keys on production. The webhook secret is created separately
# in the Razorpay dashboard; it is not the API key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
